diff --git a/.github/automation/tests/test_rule_consistency.py b/.github/automation/tests/test_rule_consistency.py
new file mode 100644
index 0000000..6f7ab51
--- /dev/null
+++ b/.github/automation/tests/test_rule_consistency.py
@@ -0,0 +1,71 @@
+"""Die drei Regelstellen (CLAUDE.md, ROUTINE_PROMPT.md, Routine-Protokoll) muessen inhaltlich uebereinstimmen."""
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[3]
+sys.path.insert(0, str(ROOT / ".github" / "automation"))
+
+import jarvis_automation as ja  # noqa: E402
+
+ALLOWED = (".github/workflows/**", ".github/automation/**")
+# Weiterhin verboten, in jeder Regelstelle (Schreibweise ohne Umlaute/Backticks normalisiert)
+STILL_FORBIDDEN = (".github/codeowners", ".claude/**", "claude.md", "backlog.json", "secrets", "main", "merge", "force")
+
+
+def _norm(text: str) -> str:
+    return text.replace("`", "").replace("ä", "ae").replace("ö", "oe").replace("ü", "ue").replace("ß", "ss").lower()
+
+
+def _protocol() -> str:
+    state = {"job_id": "job-1", "base_branch": "main", "base_sha": "abc", "timeout_minutes": 60,
+             "chain": {"id": "c1", "index": 1, "budget": 1, "item_id": None, "attempt": 1}}
+    return ja.build_routine_text(repo="DrUranus/JARVIS", state=state, issue_number=1, task="Mach etwas")
+
+
+def _sources() -> dict[str, str]:
+    return {
+        "CLAUDE.md": (ROOT / "CLAUDE.md").read_text(encoding="utf-8"),
+        "ROUTINE_PROMPT.md": (ROOT / ".github/automation/ROUTINE_PROMPT.md").read_text(encoding="utf-8"),
+        "protocol": _protocol(),
+    }
+
+
+def test_release_for_workflows_and_automation_reaches_every_rule_source():
+    for name, text in _sources().items():
+        for path in ALLOWED:
+            assert path in text, f"{name}: Freigabe fuer {path} fehlt"
+
+
+def test_release_requires_explicit_task_in_every_rule_source():
+    for name, text in _sources().items():
+        assert "ausdruecklich" in _norm(text), name
+    assert "aendern, wenn der auftragstext unten es ausdruecklich verlangt" in _norm(_protocol())
+
+
+def test_previous_prohibitions_are_kept_everywhere():
+    for name, text in _sources().items():
+        n = _norm(text)
+        for item in STILL_FORBIDDEN:
+            assert item in n, f"{name}: Verbot '{item}' fehlt"
+
+
+def test_activation_of_autonomy_stays_forbidden_everywhere():
+    for name, text in _sources().items():
+        n = _norm(text)
+        assert "aktivier" in n and "merge" in n and "sicherheitslimit" in n, name
+
+
+def test_protocol_keeps_report_format_and_stop_rules():
+    p = _protocol()
+    assert p.startswith("JARVIS-AUTOMATISIERUNGSAUFTRAG (Protokoll v1)")
+    for fragment in (ja.REPORT_MARKER, '"schema_version": 1', "genau ein Kommentar", "hoechstens drei Fehleranalyse",
+                     "Starte keine weiteren Auftraege", "-----BEGIN AUFTRAG-----\nMach etwas\n-----END AUFTRAG-----"):
+        assert fragment in p, fragment
+    assert "Pull Requests gegen main nur, wenn der Auftrag es ausdruecklich verlangt" in p
+    assert "Keine Pushes auf main" in p and "keine Force-Pushes" in p
+
+
+def test_protocol_contains_no_token_or_secret_values():
+    assert "TOKEN" not in _protocol().replace("Tokens", "").replace("Token-Rechte", "")

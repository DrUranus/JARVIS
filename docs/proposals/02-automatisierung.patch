@@ -0,0 +1,52 @@
+# Merge-Gate: bewertet PRs von claude/*-Branches, schreibt einen Statusbericht in den PR, mergt NUR bei vollstaendig erfolgreichen
+# Pflichtpruefungen fuer den freigegebenen Commit (siehe .github/automation/merge_gate.py) und stoesst bei Fehlern begrenzte
+# Korrekturauftraege an (ueber jarvis-controller.yml). Merge nur mit Variable JARVIS_AUTO_MERGE_ENABLED=true; Standard: nur Bericht.
+# Laeuft ausschliesslich mit dem Code des Standard-Branches (workflow_run/schedule/dispatch), checkt nie PR-Code aus, keine Fire-Secrets.
+name: JARVIS merge gate
+
+on:
+  workflow_run:
+    workflows: [pr-tests]
+    types: [completed]
+  schedule:
+    - cron: "*/20 * * * *"
+  workflow_dispatch:
+    inputs:
+      pr_number:
+        description: "Nur diesen PR bewerten (leer = alle offenen claude/*-PRs)"
+        required: false
+        type: string
+
+permissions:
+  contents: write        # nur fuer den Merge-Aufruf (PUT /pulls/{n}/merge mit Commit-SHA)
+  pull-requests: write
+  issues: write          # Statuskommentar, Auftrags-Issues lesen
+  checks: read
+  actions: write         # nur fuer das Anstossen von jarvis-controller.yml (Korrekturauftrag)
+
+concurrency:
+  group: jarvis-gate
+  cancel-in-progress: false
+
+jobs:
+  gate:
+    if: ${{ github.event_name == 'workflow_run' || github.ref == format('refs/heads/{0}', github.event.repository.default_branch) }}
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          ref: ${{ github.event.repository.default_branch }}
+          persist-credentials: false
+          sparse-checkout: .github/automation
+
+      - name: Evaluate pull requests
+        env:
+          GITHUB_TOKEN: ${{ github.token }}
+          DEFAULT_BRANCH: ${{ github.event.repository.default_branch }}
+          PR_NUMBER: ${{ inputs.pr_number }}
+          JARVIS_AUTOMATION_HALT: ${{ vars.JARVIS_AUTOMATION_HALT }}
+          JARVIS_TRUSTED_REPORTERS: ${{ vars.JARVIS_TRUSTED_REPORTERS }}
+          JARVIS_AUTO_MERGE_ENABLED: ${{ vars.JARVIS_AUTO_MERGE_ENABLED }}
+          JARVIS_AUTO_CONTINUE_ENABLED: ${{ vars.JARVIS_AUTO_CONTINUE_ENABLED }}
+        run: python3 .github/automation/merge_gate.py

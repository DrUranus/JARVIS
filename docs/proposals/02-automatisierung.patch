+# Pflichtpruefungen fuer Pull Requests von claude/*-Branches: volle Suite unter Linux UND Windows, auf genau dem Head-Commit des PR.
+# Die Jobnamen (tests-linux, tests-windows) sind der Nachweis, den das Merge-Gate je Commit abfragt (merge_gate.REQUIRED_CHECKS).
+# Fehlgeschlagene Tests erscheinen als Annotationen (Titel "Test fehlgeschlagen") und im Lauf-Summary. Nur contents: read, keine Secrets.
+name: pr-tests
+
+on:
+  pull_request:
+    branches: [main]
+    types: [opened, synchronize, reopened, ready_for_review]
+
+permissions:
+  contents: read
+
+concurrency:
+  group: pr-tests-${{ github.event.pull_request.number }}
+  cancel-in-progress: true
+
+defaults:
+  run:
+    shell: bash
+
+jobs:
+  tests-linux:
+    name: tests-linux
+    if: ${{ startsWith(github.head_ref, 'claude/') && github.event.pull_request.head.repo.full_name == github.repository }}
+    runs-on: ubuntu-latest
+    timeout-minutes: 45
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          ref: ${{ github.event.pull_request.head.sha }}      # genau der Commit, den das Merge-Gate pruefen wird
+          persist-credentials: false
+      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
+        with:
+          python-version: "3.13"
+      - name: Install
+        run: python -m pip install --disable-pip-version-check -e ".[dev]" pyyaml
+      - name: Tests (volle Suite)
+        run: |
+          mkdir -p reports
+          python -m pytest -p no:cacheprovider -rfEs --junitxml=reports/junit.xml
+      - name: Summary und Nachweis
+        if: ${{ !cancelled() }}
+        env:
+          HEAD_SHA: ${{ github.event.pull_request.head.sha }}
+          EVIDENCE_NAME: tests-linux
+        run: python .github/automation/junit_summary.py reports/junit.xml reports/evidence.json >> "$GITHUB_STEP_SUMMARY"
+      - name: Berichte hochladen
+        if: ${{ !cancelled() }}
+        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
+        with:
+          name: reports-tests-linux
+          path: reports/
+          if-no-files-found: warn
+          retention-days: 14
+
+  tests-windows:
+    name: tests-windows
+    if: ${{ startsWith(github.head_ref, 'claude/') && github.event.pull_request.head.repo.full_name == github.repository }}
+    runs-on: windows-latest
+    timeout-minutes: 60
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          ref: ${{ github.event.pull_request.head.sha }}
+          persist-credentials: false
+      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
+        with:
+          python-version: "3.13"
+      - name: Install (dev + voice)
+        run: python -m pip install --disable-pip-version-check -e ".[dev,voice]" pyyaml
+      - name: Tests (volle Suite)
+        run: |
+          mkdir -p reports
+          python -m pytest -p no:cacheprovider -rfEs --junitxml=reports/junit.xml
+      - name: Summary und Nachweis
+        if: ${{ !cancelled() }}
+        env:
+          HEAD_SHA: ${{ github.event.pull_request.head.sha }}
+          EVIDENCE_NAME: tests-windows
+        run: python .github/automation/junit_summary.py reports/junit.xml reports/evidence.json >> "$GITHUB_STEP_SUMMARY"
+      - name: Berichte hochladen
+        if: ${{ !cancelled() }}
+        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
+        with:
+          name: reports-tests-windows
+          path: reports/
+          if-no-files-found: warn
+          retention-days: 14

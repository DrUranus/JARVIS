# Copy to .env or export in your shell. Secrets never go into config files.
JARVIS_MODE=development
JARVIS_LLM_PROVIDER=mock
JARVIS_LLM_MODEL=mock-1
# OPENAI_API_KEY=...
# ANTHROPIC_API_KEY=...

# Voice (see README): real speech needs a provider + microphone backend
# JARVIS_VOICE_STT_PROVIDER=openai
# JARVIS_VOICE_TTS_PROVIDER=system
# JARVIS_VOICE_REQUIRE_WAKE_WORD=true

# Memory (local SQLite). use_in_prompts=true sends relevant memories to your LLM provider.
# JARVIS_MEMORY_PATH=data/memory.db
# JARVIS_MEMORY_USE_IN_PROMPTS=false

# Security (defaults are restrictive). Lists use the OS path separator (':' on Linux/macOS).
# JARVIS_SECURITY_MODE=standard            # or lockdown
# JARVIS_SECURITY_CONFIRMATION=cli          # or deny (headless)
# JARVIS_SECURITY_ALLOWED_ROOTS=workspace:/data/shared

# Computer control (opt-in; needs `pip install -e ".[computer]"`)
# JARVIS_COMPUTER_ENABLED=true
# JARVIS_COMPUTER_BACKEND=auto

# Self-improvement (Phase 15; OFF by default - see README and [self_improvement] in config/jarvis.toml)
# JARVIS_SELF_IMPROVEMENT_ENABLED=true
# JARVIS_SELF_IMPROVEMENT_REPO_PATH=/path/to/your/JARVIS/checkout
# JARVIS_SELF_IMPROVEMENT_ALLOW_PREPARE=true      # prepare + test changes in a separate git branch
# JARVIS_SELF_IMPROVEMENT_ALLOW_ACTIVATION=false  # merging an approved change needs this AND your confirmation
